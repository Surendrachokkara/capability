# Stripe (test keys are fine for the smoke test)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Price ids created in the Stripe dashboard
STRIPE_PRICE_MONTHLY=price_xxx   # $12 / month, recurring
STRIPE_PRICE_PACK=price_xxx      # $29 one-time

# Licence signing key from `npm run keygen` (keep secret)
LICENSE_PRIVATE_JWK={"kty":"EC",...}

# Where Stripe sends people back to
PUBLIC_BASE_URL=http://localhost:8787

# Optional
PORT=8787
LICENSE_DB=./data/licenses.json
